{
  "name": "coding-oidc",
  "private": true,
  "workspaces": [
    "docs",
    "templates",
    "templates/packages/*"
  ],
  "type": "module",
  "scripts": {
    "predev:templates": "bun install",
    "dev:templates": "bun --filter 'templates' dev",
    "predev:docs": "bun install",
    "dev:docs": "bun --filter 'docs' dev",
    "prebuild:templates": "bun install -p",
    "build:templates": "bun --filter 'templates' build",
    "prebuild:docs": "bun install -p",
    "build:docs": "bun --filter 'docs' build",
    "precheck": "bun install",
    "check": "bun run check:templates",
    "precheck:templates": "bun install",
    "check:templates": "bun --filter 'templates' check",
    "prelint": "bun install",
    "lint": "bun run lint:oxlint && bun run lint:vize",
    "lint:oxlint": "bun -b oxlint --fix",
    "lint:vize": "bun -b vize lint --fix",
    "preknip": "bun install",
    "knip": "bun -b knip-bun",
    "preformat": "bun install",
    "format": "bun -b vize fmt --write \"**/*.vue\" \"**/*.ts\" && bun -b oxfmt --write"
  },
  "devDependencies": {
    "knip": "6.38.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vize": "0.429.0"
  }
}
