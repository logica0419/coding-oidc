{
  "name": "templates",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently --names \"op,rp\" \"bun run dev:op\" \"bun run dev:rp\"",
    "dev:op": "bun --filter '@coding-oidc/openid-provider' dev",
    "dev:rp": "bun --filter '@coding-oidc/relying-party' dev",
    "build": "bun --filter '*' build",
    "check": "bun --filter '*' check",
    "lint": "bun run lint:oxlint && bun run lint:vize",
    "lint:oxlint": "bun -b oxlint --fix",
    "lint:vize": "bun -b vize lint --fix",
    "format": "bun -b vize fmt --write \"**/*.vue\" \"**/*.ts\" && bun -b oxfmt --write"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "7.0.2",
    "vize": "0.429.0"
  }
}
