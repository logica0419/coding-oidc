{
  "name": "templates",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently --names \"op,rp\" \"bun run dev:op\" \"bun run dev:rp\"",
    "dev:op": "bun --filter '@coding-oidc/openid-provider' dev",
    "dev:rp": "bun --filter '@coding-oidc/relying-party' dev",
    "build": "bun --filter '*' build",
    "check": "bun --filter '*' check",
    "lint": "bun -b oxlint",
    "format": "bun -b oxfmt --write"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0"
  },
  "overrides": {
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.17.tsgo.7.0.2"
  }
}
