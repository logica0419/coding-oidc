{
  "name": "Coding OIDC",
  "dockerComposeFile": ["docker-compose.yaml"],
  "service": "app",
  "workspaceFolder": "/workspaces/coding-oidc",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "26.10.0"
    },
    "ghcr.io/devcontainers-extra/features/bun:1": {
      "version": "1.4.2"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "oven.bun-vscode",
        "ubugeeei.vize",
        "typescriptteam.native-preview",
        "oxc.oxc-vscode"
      ],
      "settings": {
        "search.exclude": {
          "**/node_modules": true,
          "**/.nuxt": true,
          "**/.output": true,
          "**/.git": true
        },
        "files.watcherExclude": {
          "**/.git/objects/**": true,
          "**/.git/subtree-cache/**": true,
          "**/node_modules/*/**": true,
          "**/.nuxt": true,
          "**/.output/**": true
        },
        "search.followSymlinks": false
      }
    }
  },
  "portsAttributes": {
    "3100": { "label": "Relying Party", "onAutoForward": "notify" },
    "3101": { "label": "OpenID Provider", "onAutoForward": "notify" },
    "6379": { "label": "Valkey", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bun install && bun run build",
  "remoteUser": "vscode"
}
