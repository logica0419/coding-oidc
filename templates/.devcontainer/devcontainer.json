{
  "name": "Coding OIDC",
  "dockerComposeFile": ["../compose.yaml"],
  "service": "app",
  "workspaceFolder": "/workspaces/coding-oidc",
  "customizations": {
    "vscode": {
      "extensions": ["oven.bun-vscode", "vue.volar", "oxc.oxc-vscode"]
    }
  },
  "portsAttributes": {
    "3100": { "label": "Relying Party", "onAutoForward": "notify" },
    "3101": { "label": "OpenID Provider", "onAutoForward": "notify" },
    "6379": { "label": "Redis", "onAutoForward": "silent" }
  },
  "postCreateCommand": "mise trust && mise install && bun install",
  "remoteUser": "vscode"
}
