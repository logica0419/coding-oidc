{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.nuxt/**",
    "**/.output/**",
    "**/dist/**",
    "**/.data/**"
  ],
  "categories": {
    "correctness": "error"
  },
  "overrides": [
    {
      "files": ["**/*.vue"],
      "rules": {
        "no-unused-vars": "off"
      }
    }
  ]
}
